import math

def calculator(a, b, op):
    if op == "+":
        return a + b
    elif op == "-":
        return a - b
    elif op == "*":
        return a * b
    elif op == "/":
        return "Cannot divide by zero" if b == 0 else a / b
    elif op == "**":
        return a ** b
    elif op == "%":
        return a % b
    elif op == "sqrt":
        return math.sqrt(a) if a >= 0 else "Invalid number"
    else:
        return "Invalid operation"


try:
    a = float(input("Enter first number: "))
    b = float(input("Enter second number: "))
    op = input("Enter operation (+, -, , /, *, %, sqrt): ")

    print("Result:", calculator(a, b, op))

except ValueError:
    print("Please enter valid numbers.")